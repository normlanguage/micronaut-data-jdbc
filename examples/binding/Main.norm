package binding

import micronaut.data.jdbc.annotation.JdbcRepository
import micronaut.data.jdbc.Dialect

@JdbcRepository(dialect: Dialect.H2)
interface Messages {
}

Void main() {
  require(condition: Messages.class.annotation<JdbcRepository>() != null, message: "JdbcRepository binding is missing")
  printLine("jdbc repository")
}
